# Copia este archivo como .env y rellena DB_PASSWORD y JWT_SECRETO.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

DB_HOST=uniconnect-db.ddns.net
DB_PORT=3306
DB_NAME=uniconnect
DB_USER=uniconnect_dev
DB_PASSWORD=

# Clave para firmar los tokens JWT (HS256). Debe tener al menos 32 caracteres.
# Genera una propia, por ejemplo con: openssl rand -base64 48
JWT_SECRETO=
# Vigencia del token en milisegundos (por defecto 24 horas)
JWT_EXPIRACION_MS=86400000

# Carpeta donde se guardan los archivos subidos (relativa a la raiz del modulo)
ARCHIVOS_DIRECTORIO=./uploads
